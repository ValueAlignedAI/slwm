{
  "runtime": {
    "seed": 20260521,
    "deterministic": true,
    "device": "cpu",
    "precision": "fp32"
  },
  "model": {
    "name": "slwm-t2-external-control-smoke",
    "variant": "slwm_audio_visual_latent",
    "parameter_accounting_mode": "strict",
    "context_length": 1024,
    "latent_length": 1024,
    "latent_dim": 64,
    "n_layer": 1,
    "n_head": 4,
    "dropout": 0.0,
    "audio_feature_dim": 80,
    "visual_feature_dim": 256,
    "architecture_flags": {
      "use_local_temporal_mixer": true,
      "use_spectral_mixer": true,
      "use_long_conv": true,
      "use_attention_binding": true,
      "use_gated_mlp": true,
      "local_kernel_size": 3,
      "spectral_kernel_size": 7,
      "long_kernel_size": 7,
      "mlp_ratio": 2,
      "policy_commit_gate": false,
      "noop_head": false,
      "activation_checkpointing": false
    }
  },
  "data": {
    "modalities": [
      "audio",
      "visual_video"
    ],
    "prepared_corpus_dir": "artifacts/t2_audio_visual/external_t2_control_v0",
    "sample_schema_version": "t2.audio_visual_latents_v0",
    "dataset_mix": {
      "text_code": null,
      "audio": 0.5,
      "visual_video": 0.5
    }
  },
  "training": {
    "objective": [
      "audio_latent_continuation_mse",
      "visual_latent_continuation_mse",
      "missing_span_reconstruction_mse",
      "audio_video_contrastive_alignment"
    ],
    "optimizer": "adamw_torch",
    "learning_rate_schedule": "constant",
    "learning_rate": 0.001,
    "weight_decay": 0.0,
    "batch_size": 4,
    "gradient_accumulation_steps": 1,
    "eval_batch_size": 4,
    "steps": 4,
    "validation_batches": 1,
    "log_interval_steps": 1,
    "checkpoint_interval_steps": 1,
    "keep_last_n_checkpoints": 2,
    "context_fraction": 0.5,
    "missing_span_fraction": 0.125,
    "grad_clip_norm": 1.0,
    "loss_weights": {
      "audio_prediction": 1.0,
      "visual_prediction": 1.0,
      "alignment": 0.1
    },
    "claim_scope": "External control latent loader/training smoke only; B>=2 keeps AV contrastive metrics non-degenerate, but no natural AV or model-quality claim is made."
  },
  "registry": {
    "experiment_id": "EXP-T2-902",
    "artifact_dir": "experiments/multimodal/t2/EXP-T2-902",
    "path": "experiments/multimodal/t2/EXP-T2-902/registry.json",
    "metrics_path": "experiments/multimodal/t2/EXP-T2-902/metrics.json",
    "report_path": "experiments/multimodal/t2/EXP-T2-902/report.md",
    "checkpoint_path": "experiments/multimodal/t2/EXP-T2-902/checkpoint.pt",
    "latest_checkpoint_path": "experiments/multimodal/t2/EXP-T2-902/latest.pt",
    "checkpoint_index_path": "experiments/multimodal/t2/EXP-T2-902/checkpoints.json",
    "run_state_path": "experiments/multimodal/t2/EXP-T2-902/run_state.json",
    "config_copy_path": "experiments/multimodal/t2/EXP-T2-902/config.json",
    "progress_path": "experiments/multimodal/t2/EXP-T2-902/progress.jsonl"
  }
}
